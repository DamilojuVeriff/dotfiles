#!/usr/bin/env bash

echo "Setting up your Mac..."

DOTFILES=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

link_file() { rm -rf "$2" && ln -sf "$1" "$2" && echo "Linked $1 → $2"; }

# Check if Xcode Command Line Tools are installed
echo ""
echo "==> Checking Xcode Command Line Tools..."
if ! xcode-select -p &>/dev/null; then
  echo "Xcode Command Line Tools not found. Installing..."
  xcode-select --install
else
  echo "Xcode Command Line Tools already installed."
fi

# Check for Oh My Zsh and install if we don't have it
echo ""
echo "==> Checking Oh My Zsh..."
if [ ! -d "$HOME/.oh-my-zsh" ]; then
  /bin/sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/HEAD/tools/install.sh)"
else
  echo "Oh My Zsh already installed."
fi

# Check for Homebrew and install if we don't have it
echo ""
echo "==> Checking Homebrew..."
if test ! "$(which brew)"; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  echo "Homebrew already installed."
fi

# Zsh configuration
echo ""
echo "==> Linking Zsh configuration..."
link_file $DOTFILES/zsh/.zprofile $HOME/.zprofile
link_file $DOTFILES/zsh/.zshrc $HOME/.zshrc
link_file $DOTFILES/zsh/.p10k.zsh $HOME/.p10k.zsh
link_file $DOTFILES/.hushlogin $HOME/.hushlogin

# Tmux
echo ""
echo "==> Linking Tmux configuration..."
link_file $DOTFILES/tmux/tmux.conf $HOME/.tmux.conf

# Scripts
echo ""
echo "==> Linking scripts..."
mkdir -p $HOME/.local/bin
link_file $DOTFILES/scripts/t $HOME/.local/bin/t
link_file $DOTFILES/scripts/nvim-health $HOME/.local/bin/nvim-health
link_file $DOTFILES/scripts/update $HOME/.local/bin/update

# NVIM
echo ""
echo "==> Linking Neovim configuration..."
link_file $DOTFILES/nvim $HOME/.config/nvim

# Update Homebrew
echo ""
echo "==> Updating Homebrew and installing dependencies..."
brew update

# Install all our dependencies with bundle (See Brewfile)
brew bundle --file ./homebrew/Brewfile

# Ghostty
echo ""
echo "==> Linking Ghostty configuration"
link_file $DOTFILES/ghostty/config.ghostty $HOME/Library/Application\ Support/com.mitchellh.ghostty/config.ghostty

# NVM (Node Version Manager)
echo ""
echo "==> Linking NVM configuration..."
mkdir -p $HOME/.nvm
link_file $DOTFILES/nvm/default-packages $HOME/.nvm/default-packages

# Ensure NVM is loaded
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

echo "Ensuring all default global packages are installed..."
# Reads your file, ignores comments/empty lines, and installs if missing
grep -v '^#' "$NVM_DIR/default-packages" | grep -v '^$' | xargs npm install -g

# Lazygit
echo ""
echo "==> Linking Lazygit configuration..."
mkdir -p $HOME/.config/lazygit
link_file $DOTFILES/lazygit/config.yml $HOME/.config/lazygit/config.yml

# Claude
echo ""
echo "==> Linking Claude configuration..."
mkdir -p $HOME/.claude
link_file $DOTFILES/.claude/settings.json $HOME/.claude/settings.json

# Editorconfig
echo ""
echo "==> Linking Editorconfig..."
link_file $DOTFILES/.editorconfig $HOME/.editorconfig

# Tmux Plugin Manager
echo ""
echo "==> Checking Tmux Plugin Manager..."
if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
  git clone https://github.com/tmux-plugins/tpm $HOME/.tmux/plugins/tpm
else
  echo "Tmux Plugin Manager already installed."
fi

# macOS defaults (optional - uncomment to apply developer-friendly system preferences)
source $DOTFILES/macos/defaults.sh

# Git
echo ""
echo "==> Linking Git configuration..."
link_file $DOTFILES/git/gitconfig $HOME/.gitconfig
link_file $DOTFILES/git/.gitignore_global $HOME/.gitignore_global
if [ ! -f "$HOME/.gitconfig.local" ]; then
  cat > $HOME/.gitconfig.local << 'EOF'
[user]
    email =
EOF
  printf '\033[1;33m⚠️  Created ~/.gitconfig.local — set your email there\033[0m\n'
fi

# Create a projects directories
mkdir -p $HOME/Code

echo ""
echo "Done! 🎉"
